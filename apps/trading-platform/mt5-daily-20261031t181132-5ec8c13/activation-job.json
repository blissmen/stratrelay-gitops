{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "mt5-daily-20261031t181132-5ec8c13-activate",
    "namespace": "trading"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 120,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "mt5-daily-20261031t181132-5ec8c13-activate"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "imagePullSecrets": [
          {
            "name": "ghcr-pull"
          }
        ],
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "runAsGroup": 65532,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "activate",
            "image": "ghcr.io/strat-relay/trading-platform-runtime@sha256:e92f98691996761024026a1c5d0ebcf55097059c368c357bdf87a1d5469a36d0",
            "command": [
              "python",
              "-c",
              "import os\nfrom pathlib import Path\nimport psycopg\ntry:\n    activation=Path('/config/activation.sql').read_text()\n    registration=Path('/config/registration.sql').read_text()\n    if activation.count('BEGIN;') != 1:\n        raise ValueError('single guarded activation transaction required')\n    sql=activation.replace('BEGIN;', 'BEGIN;'+registration, 1)\n    with psycopg.connect(host='trading-postgres.trading.svc.cluster.local',port=5432,\n            dbname='trading_platform',user=os.environ['PGUSER'],password=os.environ['PGPASSWORD'],\n            connect_timeout=5) as conn:\n        conn.execute(sql)\n    print('MT5_COUNTERPART_REGISTRATION_AND_ACTIVATION_COMMITTED',flush=True)\nexcept Exception as exc:\n    print('MT5_COUNTERPART_ACTIVATION_BLOCKED '+type(exc).__name__,flush=True)\n    raise SystemExit(1)\n"
            ],
            "env": [
              {
                "name": "PGUSER",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "trading-postgres-auth",
                    "key": "POSTGRES_ADMIN_USER"
                  }
                }
              },
              {
                "name": "PGPASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "trading-postgres-auth",
                    "key": "POSTGRES_ADMIN_PASSWORD"
                  }
                }
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "25m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "200m",
                "memory": "128Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "config",
                "mountPath": "/config",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "config",
            "configMap": {
              "name": "mt5-daily-20261031t181132-5ec8c13-manifest"
            }
          }
        ]
      }
    }
  }
}
