{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "market-data-collector",
    "namespace": "trading"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "collector",
            "image": "ghcr.io/strat-relay/trading-platform-runtime@sha256:f25fbda211144be613866bb50cb120f9c6b2844d697a29abd5ae6f551a9aaa6f",
            "envFrom": [
              {
                "secretRef": {
                  "name": "trading-runtime-endpoints"
                }
              },
              {
                "configMapRef": {
                  "name": "trading-db-primary-prepared"
                }
              },
              {
                "secretRef": {
                  "name": "library-event-collector"
                }
              }
            ],
            "env": [
              {
                "name": "MARKET_DATA_D1_SYMBOLS",
                "value": "BTCUSDm"
              },
              {
                "name": "MARKET_DATA_EVENT_MODE",
                "value": "JETSTREAM_OUTBOX"
              },
              {
                "name": "MARKET_DATA_EVENT_SYMBOLS",
                "value": "BTCUSDm"
              },
              {
                "name": "LIBRARY_EVENT_DATABASE",
                "value": "trading_platform"
              }
            ]
          }
        ]
      }
    }
  }
}
