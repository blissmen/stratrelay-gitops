{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "donchian-breakout-v2-postgres-ingress",
        "namespace": "trading"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "trading-postgres"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "donchian-breakout-v2-observer"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 5432,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "donchian-breakout-v2-redis-ingress",
        "namespace": "trading"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "trading-redis"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "donchian-breakout-v2-observer"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 6379,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    }
  ]
}
